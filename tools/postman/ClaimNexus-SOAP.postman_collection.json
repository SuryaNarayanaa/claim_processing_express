{
  "info": {
    "name": "ClaimNexus SOAP | MongoDB, Neo4j and XML demo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run folders in order. SOAP requests use XML throughout. Imports use the original repository XML feeds and capture claim IDs automatically. Demo master records are synthetic. This collection adds demo records; it never deletes data. Repeated imports use stable transaction IDs and replay existing claims. API key is blank by default; set it locally if configured."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3100",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "",
      "type": "string"
    },
    {
      "key": "autoClaimId",
      "value": "",
      "type": "string"
    },
    {
      "key": "healthClaimId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Connection and MongoDB models",
      "item": [
        {
          "name": "Read WSDL XML contract",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": "{{baseUrl}}/soap?wsdl"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('WSDL retrieved', () => pm.response.to.have.status(200));",
                  "pm.test('Typed service contract', () => pm.expect(pm.response.text()).to.include('ClaimInput'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Check both databases",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/xml; charset=utf-8"
              },
              {
                "key": "SOAPAction",
                "value": "\"urn:claimnexus/GetHealth\""
              },
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <GetHealth xmlns=\"urn:claimnexus\">\n\n    </GetHealth>\n  </soap:Body>\n</soap:Envelope>",
              "options": {
                "raw": {
                  "language": "xml"
                }
              }
            },
            "url": "{{baseUrl}}/soap",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const xml2js = require('xml2js');",
                  "xml2js.parseString(pm.response.text(), {",
                  "  explicitArray: false,",
                  "  tagNameProcessors: [xml2js.processors.stripPrefix]",
                  "}, (error, parsed) => {",
                  "  pm.test('Valid SOAP response', () => pm.expect(error).to.equal(null));",
                  "  if (error) return;",
                  "  const body = parsed.Envelope.Body;",
                  "  pm.test('No SOAP fault', () => pm.expect(body.Fault).to.equal(undefined));",
                  "  const data = body.GetHealthResponse;",
                  "  pm.test('GetHealth response exists', () => pm.expect(data).to.exist);",
                  "  if (!data) return;",
                  "  pm.test('MongoDB connected', () => pm.expect(data.mongodb).to.equal('CONNECTED'));",
                  "pm.test('Neo4j connected', () => pm.expect(data.neo4j).to.equal('CONNECTED'));",
                  "});"
                ]
              }
            }
          ]
        },
