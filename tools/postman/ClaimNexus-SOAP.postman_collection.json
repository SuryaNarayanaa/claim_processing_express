            "body": {
              "mode": "raw",
              "raw": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <ImportClaimsXml xmlns=\"urn:claimnexus\">\n      <xml>&lt;?xml version=\"1.0\" encoding=\"UTF-8\"?&gt;\r\n&lt;ClaimsBatch source=\"ACORD_GATEWAY_PARTNER\" generatedAt=\"2026-03-28T08:00:00Z\"&gt;\r\n  &lt;ACORDClaim&gt;\r\n    &lt;TransactionId&gt;XML-TX-AUTO-1001&lt;/TransactionId&gt;\r\n    &lt;PolicyRef&gt;POL-8101-TX&lt;/PolicyRef&gt;\r\n    &lt;InsuredRef&gt;CUST-XML-01&lt;/InsuredRef&gt;\r\n    &lt;LossType&gt;AUTO&lt;/LossType&gt;\r\n    &lt;LossDate&gt;2026-03-20&lt;/LossDate&gt;\r\n    &lt;NoticeAt&gt;2026-03-21&lt;/NoticeAt&gt;\r\n    &lt;TotalLossAmount&gt;8500.00&lt;/TotalLossAmount&gt;\r\n    &lt;Currency&gt;USD&lt;/Currency&gt;\r\n    &lt;LossNarrative&gt;Frontal bumper and radiator damage following low-speed urban collision.&lt;/LossNarrative&gt;\r\n    &lt;RepairFacilityId&gt;GARAGE-CENTRAL-01&lt;/RepairFacilityId&gt;\r\n    &lt;RepairFacilityName&gt;Central Metro Collision&lt;/RepairFacilityName&gt;\r\n    &lt;ProducerId&gt;AGENT-LONE-STAR&lt;/ProducerId&gt;\r\n    &lt;ProducerName&gt;Lone Star Underwriters&lt;/ProducerName&gt;\r\n    &lt;IncidentLocation&gt;1200 S Congress Ave&lt;/IncidentLocation&gt;\r\n    &lt;IncidentCity&gt;Austin&lt;/IncidentCity&gt;\r\n    &lt;IncidentState&gt;TX&lt;/IncidentState&gt;\r\n    &lt;InsuredZip&gt;78704&lt;/InsuredZip&gt;\r\n    &lt;AutoDetails&gt;\r\n      &lt;Vin&gt;1FTFW1ED4MFA19283&lt;/Vin&gt;\r\n      &lt;LicensePlate&gt;TX-448-ABC&lt;/LicensePlate&gt;\r\n      &lt;Make&gt;Ford&lt;/Make&gt;\r\n      &lt;Model&gt;F-150&lt;/Model&gt;\r\n      &lt;Year&gt;2023&lt;/Year&gt;\r\n      &lt;RepairCost&gt;8500.00&lt;/RepairCost&gt;\r\n      &lt;IsDrivable&gt;true&lt;/IsDrivable&gt;\r\n      &lt;HasPoliceReport&gt;true&lt;/HasPoliceReport&gt;\r\n    &lt;/AutoDetails&gt;\r\n  &lt;/ACORDClaim&gt;\r\n\r\n  &lt;ACORDClaim&gt;\r\n    &lt;TransactionId&gt;XML-TX-AUTO-1002&lt;/TransactionId&gt;\r\n    &lt;PolicyRef&gt;POL-8102-TX&lt;/PolicyRef&gt;\r\n    &lt;InsuredRef&gt;CUST-XML-02&lt;/InsuredRef&gt;\r\n    &lt;LossType&gt;AUTO&lt;/LossType&gt;\r\n    &lt;LossDate&gt;2026-03-22&lt;/LossDate&gt;\r\n    &lt;NoticeAt&gt;2026-03-22&lt;/NoticeAt&gt;\r\n    &lt;TotalLossAmount&gt;12800.00&lt;/TotalLossAmount&gt;\r\n    &lt;Currency&gt;USD&lt;/Currency&gt;\r\n    &lt;LossNarrative&gt;Side door and quarter panel crushing sustained in parking garage.&lt;/LossNarrative&gt;\r\n    &lt;RepairFacilityId&gt;GARAGE-CENTRAL-01&lt;/RepairFacilityId&gt;\r\n    &lt;RepairFacilityName&gt;Central Metro Collision&lt;/RepairFacilityName&gt;\r\n    &lt;ProducerId&gt;AGENT-LONE-STAR&lt;/ProducerId&gt;\r\n    &lt;ProducerName&gt;Lone Star Underwriters&lt;/ProducerName&gt;\r\n    &lt;IncidentLocation&gt;400 W 6th St&lt;/IncidentLocation&gt;\r\n    &lt;IncidentCity&gt;Austin&lt;/IncidentCity&gt;\r\n    &lt;IncidentState&gt;TX&lt;/IncidentState&gt;\r\n    &lt;InsuredZip&gt;78701&lt;/InsuredZip&gt;\r\n    &lt;AutoDetails&gt;\r\n      &lt;Vin&gt;4T1B11HK5JU819203&lt;/Vin&gt;\r\n      &lt;LicensePlate&gt;TX-991-ZXY&lt;/LicensePlate&gt;\r\n      &lt;Make&gt;Toyota&lt;/Make&gt;\r\n      &lt;Model&gt;Camry&lt;/Model&gt;\r\n      &lt;Year&gt;2021&lt;/Year&gt;\r\n      &lt;RepairCost&gt;12800.00&lt;/RepairCost&gt;\r\n      &lt;IsDrivable&gt;false&lt;/IsDrivable&gt;\r\n      &lt;HasPoliceReport&gt;false&lt;/HasPoliceReport&gt;\r\n    &lt;/AutoDetails&gt;\r\n  &lt;/ACORDClaim&gt;\r\n&lt;/ClaimsBatch&gt;\r\n</xml>\n    </ImportClaimsXml>\n  </soap:Body>\n</soap:Envelope>",
              "options": {
                "raw": {
                  "language": "xml"
